# Contact form transport. Copy this file to .env and fill in the key.
# .env is gitignored; this file is committed as documentation.
#
# Get a key at https://web3forms.com — enter your email and it is sent to you.
# There is no account to create.

VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit
VITE_CONTACT_ACCESS_KEY=
